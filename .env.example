# ==============================================================================
# Imprenditore 5.0 — Environment Variables Template (.env.example)
# Copy this file to .env.local for local development, or add these in Vercel Settings:
# ==============================================================================

# 1. Public Convex Cloud URL used by the React frontend (Vite)
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# 2. Client-facing admin passcode for Race Director login
VITE_ADMIN_KEY=your_admin_passcode_here

# 3. Twelve Data API Credentials (configured on Convex server or local dev)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
